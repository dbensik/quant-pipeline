# --- Byte-compiled / optimized / C extensions ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# --- Distribution / Packaging ---
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
*.tar.gz

# --- Database Files ---
# Ignore the main SQLite database and any backups or journals
*.db
*.db-journal*

# --- Runtime Generated Data & Caches ---
# Ignore the cache directory used by the constituents fetcher
scripts/.cache/
.cache/
# Ignore any data files that might be downloaded or generated
/data/
results/
audit_log.json

# --- User / Portfolio Data ---
portfolio.json
portfolios.json
watchlists.json

# --- Claude Code Workspace ---
.claude/

# --- Test Artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.prof
*.lprof

# --- Jupyter Notebook ---
.ipynb_checkpoints

# --- IDE / Editor specific ---
.idea/          # PyCharm
.vscode/        # VSCode
*.iml           # IntelliJ
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Environment & Secrets ---
# Never commit environment variables or secrets
.env
.env.*
*.env
# ...but the committed template is allowed
!.env.example

# Poetry in-project virtualenv (poetry.toml sets in-project = true)
.venv/

# --- Frontend ---
frontend/node_modules/
package-lock.json

# --- Dependency Lock Files ---
poetry.lock
poetry.toml

# --- Debug / Diagnostic Scripts ---
debug_*.py
diagnose_*.py
verify_*.py

# --- Project Specific Ignores ---
# Ignore personal or non-code project files
PROJECT.md
*.bak