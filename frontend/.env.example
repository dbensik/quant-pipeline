# Frontend environment template. Copy to `.env` (gitignored).
#
# Vite only exposes variables prefixed with VITE_ to client code. Anything else
# here is dead weight — and secrets in this directory are a hazard, since a
# client bundle is public by definition. NEVER put database URLs or credentials
# in a frontend .env.
VITE_API_BASE_URL=http://127.0.0.1:8001
